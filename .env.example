# Set ONE of these in Vercel (Project Settings -> Environment Variables).
# Priority order: OPENAI_API_KEY, then GROQ_API_KEY, then GEMINI_API_KEY.
OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Optional: override the default model for whichever provider is active.
# Defaults: OpenAI gpt-4o-mini | Groq llama-3.3-70b-versatile | Gemini gemini-2.0-flash
# LLM_MODEL=
